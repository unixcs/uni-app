; Production template for wx.gxwqb.cn.
; Copy this file to /opt/yoshop/yoshop2.0/.env and replace every placeholder.
APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
APP_URL = https://wx.gxwqb.cn
; Keep the public host aligned with the nginx server_name.
HOST = https://wx.gxwqb.cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = your_database
USERNAME = your_user
PASSWORD = your_password
HOSTPORT = 3306
CHARSET = utf8
DEBUG = false
; Use a dedicated production database and least-privilege user.
; Do not leave placeholder credentials in the deployed .env file.

[CACHE]
DRIVER = file
; Switch to redis only if your production cache/session config is ready.

[REDIS]
HOSTNAME = 127.0.0.1
HOSTPORT = 6379
PASSWORD =
SELECT = 0
; Leave Redis bound to localhost unless you have a private network and ACLs.

[LANG]
default_lang = zh-cn

[VIRTUAL_PAYMENT]
ENABLED = 0
ENV = 1
OFFER_ID =
SANDBOX_APP_KEY =
PRODUCTION_APP_KEY =
MERCHANT_ID =
NOTIFY_BASE_URL = https://wx.oiob.cn
MESSAGE_PUSH_TOKEN =
MESSAGE_PUSH_ENCODING_AES_KEY =
; SECURITY REMINDERS:
; 1) Keep APP_DEBUG disabled in production.
; 2) Replace database and Redis placeholders before launch.
; 3) Never commit the real .env back to git.
; 4) Keep virtual-payment secrets only in deployed env / secret manager, not in repo docs or SQL.
